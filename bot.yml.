name: Lead Radar
on:
  workflow_dispatch:
  schedule:
    - cron: "17 */6 * * *"
permissions:
  contents: write
concurrency:
  group: lead-radar
  cancel-in-progress: false
jobs:
  monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"
      - name: Install dependencies
        run: pip install -r requirements.txt
      - name: Run Lead Radar
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          YOUTUBE_API_KEY: ${{ secrets.YOUTUBE_API_KEY }}
          MIN_SCORE: "55"
          MAX_ALERTS_PER_RUN: "10"
        run: python bot.py
      - name: Save deduplication state
        run: |
          if [ -n "$(git status --porcelain leads_state.json)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add leads_state.json
            git commit -m "Update Lead Radar state [skip ci]"
            git push
          fi
**После вставки:**
1. Нажми **Commit changes**.
2. Открой **Settings → Actions → General**.
3. В разделе *Workflow permissions* включи **Read and write permissions** и сохрани настройки.
4. Открой **Actions → Lead Radar → Run workflow** и запусти проверку.
⚠️ **Важно:** перед запуском убедись, что `bot.py` и `requirements.txt` уже заменены новыми версиями. Иначе workflow может запустить старый код.
Если появится красный крестик, пришли мне текст ошибки из журнала выполнения — исправим конкретную проблему.
