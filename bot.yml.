name: Threads Vintage Monitor

on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:
  push:
    paths:
      - "bot.py"
      - ".github/workflows/**"

permissions:
  contents: write

concurrency:
  group: threads-vintage-monitor
  cancel-in-progress: false

jobs:
  monitor:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run Threads monitor
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SEEN_FILE: seen.json
          POLL_SECONDS: "900"
        run: python bot.py --once

      - name: Save seen posts
        run: |
          git config user.name "threads-bot"
          git config user.email "threads-bot@users.noreply.github.com"
          git add seen.json

          if ! git diff --cached --quiet; then
            git commit -m "Update seen posts"
            git pull --rebase origin main
            git push origin HEAD:main
          else
            echo "No changes to seen.json"
          fi
